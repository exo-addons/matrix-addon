<configuration
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.exoplatform.org/xml/ns/kernel_1_2.xsd http://www.exoplatform.org/xml/ns/kernel_1_2.xsd"
        xmlns="http://www.exoplatform.org/xml/ns/kernel_1_2.xsd">
  <external-component-plugins>
    <target-component>org.exoplatform.commons.addons.AddOnService</target-component>
    <component-plugin>
      <name>matrixChatButton</name>
      <set-method>addPlugin</set-method>
      <type>org.exoplatform.commons.addons.AddOnPluginImpl</type>
      <init-params>
        <value-param>
          <name>priority</name>
          <value>2</value>
        </value-param>
        <value-param>
          <name>containerName</name>
          <value>middle-topNavigation-container</value>
        </value-param>
        <object-param>
          <name>matrixChatApplication</name>
          <object type="org.exoplatform.commons.addons.PortletModel">
            <field name="id">
              <string>chat</string>
            </field>
            <field name="contentId">
              <string>matrix/Matrix</string>
            </field>
            <field name="permissions">
              <collection type="java.util.ArrayList">
                <value>
                  <string>*:/platform/users</string>
                </value>
                <value>
                  <string>*:/platform/externals</string>
                </value>
              </collection>
            </field>
            <field name="title">
              <string>generalSettings.chat.name</string>
            </field>
            <field name="description">
              <string>generalSettings.chat.description</string>
            </field>
            <field name="icon">
              <string>fa-comments</string>
            </field>
            <field name="showApplicationMode">
              <boolean>false</boolean>
            </field>
          </object>
        </object-param>
      </init-params>
    </component-plugin>
  </external-component-plugins>

  <external-component-plugins>
    <target-component>org.exoplatform.web.filter.ExtensibleFilter</target-component>
    <component-plugin>
      <name>Filter useful to set a JWT for authentication o Matrix</name>
      <set-method>addFilterDefinitions</set-method>
      <type>org.exoplatform.web.filter.FilterDefinitionPlugin</type>
      <init-params>
        <object-param>
          <name>Matrix JWT Filter</name>
          <object type="org.exoplatform.web.filter.FilterDefinition">
            <field name="filter">
              <object type="io.meeds.chat.web.MatrixAuthJWTFilter" />
            </field>
            <field name="patterns">
              <collection type="java.util.ArrayList" item-type="java.lang.String">
                <value>
                  <string>/.*</string>
                </value>
              </collection>
            </field>
          </object>
        </object-param>
      </init-params>
    </component-plugin>
  </external-component-plugins>

  <external-component-plugins>
    <target-component>org.exoplatform.commons.upgrade.UpgradeProductService</target-component>
    <component-plugin>
      <name>MatrixRoomAndAccountsDataInitializer</name>
      <set-method>addUpgradePlugin</set-method>
      <type>io.meeds.chat.upgrade.MatrixRoomAndAccountsUpgradePlugin</type>
      <description>Create Matrix rooms for existing spaces</description>
      <init-params>
        <value-param>
          <name>product.group.id</name>
          <description>The groupId of the product</description>
          <value>org.exoplatform.platform</value>
        </value-param>
        <value-param>
          <name>plugin.upgrade.target.version</name>
          <description>The plugin target version</description>
          <value>7.0.0</value>
        </value-param>
        <value-param>
          <name>plugin.execution.order</name>
          <description>The plugin execution order</description>
          <value>100</value>
        </value-param>
        <value-param>
          <name>plugin.upgrade.execute.once</name>
          <description>The plugin must be executed only once</description>
          <value>true</value>
        </value-param>
        <value-param>
          <name>plugin.upgrade.async.execution</name>
          <description>The plugin will be executed in an asynchronous mode</description>
          <value>true</value>
        </value-param>
      </init-params>
    </component-plugin>
    <component-plugin>
      <name>MatrixRoomUpdatePermissions</name>
      <set-method>addUpgradePlugin</set-method>
      <type>io.meeds.chat.upgrade.UpdateRoomPermissionsUpgradePlugin</type>
      <description>Update Matrix rooms permissions</description>
      <init-params>
        <value-param>
          <name>product.group.id</name>
          <description>The groupId of the product</description>
          <value>org.exoplatform.platform</value>
        </value-param>
        <value-param>
          <name>plugin.upgrade.target.version</name>
          <description>The plugin target version</description>
          <value>7.0.0</value>
        </value-param>
        <value-param>
          <name>plugin.execution.order</name>
          <description>The plugin execution order</description>
          <value>100</value>
        </value-param>
        <value-param>
          <name>plugin.upgrade.execute.once</name>
          <description>The plugin must be executed only once</description>
          <value>true</value>
        </value-param>
        <value-param>
          <name>plugin.upgrade.async.execution</name>
          <description>The plugin will be executed in an asynchronous mode</description>
          <value>true</value>
        </value-param>
      </init-params>
    </component-plugin>
    <component-plugin>
      <name>MatrixRemoveProfileProperty</name>
      <set-method>addUpgradePlugin</set-method>
      <type>io.meeds.chat.upgrade.RemoveProfilePropertyUpgradePlugin</type>
      <description>Remove Matrix ID profile property</description>
      <init-params>
        <value-param>
          <name>product.group.id</name>
          <description>The groupId of the product</description>
          <value>org.exoplatform.platform</value>
        </value-param>
        <value-param>
          <name>plugin.upgrade.target.version</name>
          <description>The plugin target version</description>
          <value>7.1.0</value>
        </value-param>
        <value-param>
          <name>plugin.execution.order</name>
          <description>The plugin execution order</description>
          <value>100</value>
        </value-param>
        <value-param>
          <name>plugin.upgrade.execute.once</name>
          <description>The plugin must be executed only once</description>
          <value>true</value>
        </value-param>
        <value-param>
          <name>plugin.upgrade.async.execution</name>
          <description>The plugin will be executed in an asynchronous mode</description>
          <value>true</value>
        </value-param>
      </init-params>
    </component-plugin>
  </external-component-plugins>


  <external-component-plugins>
    <target-component>org.exoplatform.groovyscript.text.TemplateService</target-component>
    <component-plugin>
      <name>UIPortalApplication-Start-head</name>
      <set-method>addTemplateExtension</set-method>
      <type>org.exoplatform.groovyscript.text.TemplateExtensionPlugin</type>
      <init-params>
        <values-param>
          <name>templates</name>
          <description>A template that will be imported in head of pages to add matrix properties as JS variables</description>
          <value>war:/groovy/template/UIMatrixHeadTemplate.gtmpl</value>
        </values-param>
      </init-params>
    </component-plugin>
  </external-component-plugins>

  <external-component-plugins>
    <target-component>org.exoplatform.commons.api.notification.service.setting.PluginSettingService</target-component>
    <component-plugin>
      <name>notification.groups</name>
      <set-method>registerGroupConfig</set-method>
      <type>org.exoplatform.commons.api.notification.plugin.GroupProviderPlugin</type>
      <description>Matrix chat group</description>
      <init-params>
        <object-param>
          <name>group.Matrix.chat</name>
          <description>The information of group Meeds Chat</description>
          <object type="org.exoplatform.commons.api.notification.plugin.config.GroupConfig">
            <field name="id">
              <string>matrix</string>
            </field>
            <field name="resourceBundleKey">
              <string>UINotification.label.group.Matrix</string>
            </field>
            <field name="order">
              <string>200</string>
            </field>
          </object>
        </object-param>
      </init-params>
    </component-plugin>
  </external-component-plugins>

  <external-component-plugins>
    <target-component>org.exoplatform.commons.api.notification.service.setting.PluginContainer</target-component>
    <component-plugin>
      <name>notification.plugins</name>
      <set-method>addPlugin</set-method>
      <type>io.meeds.chat.notification.MentionReceivedNotificationPlugin</type>
      <init-params>
        <object-param>
          <name>template.MatrixMentionReceivedNotificationPlugin</name>
          <description>The template of MatrixMessageReceivedNotificationPlugin</description>
          <object type="org.exoplatform.commons.api.notification.plugin.config.PluginConfig">
            <field name="pluginId">
              <string>MatrixMentionReceivedNotificationPlugin</string>
            </field>
            <field name="resourceBundleKey">
              <string>UINotification.title.MatrixMentionReceivedNotificationPlugin</string>
            </field>
            <field name="order">
              <string>4</string>
            </field>
            <field name="defaultConfig">
              <collection type="java.util.ArrayList">
                <value>
                  <string>Instantly</string>
                </value>
              </collection>
            </field>
            <field name="groupId">
              <string>matrix</string>
            </field>
            <field name="bundlePath">
              <string>locale.notification.MatrixChat</string>
            </field>
            <field name="mutable">
              <boolean>false</boolean>
            </field>
          </object>
        </object-param>
      </init-params>
    </component-plugin>
  </external-component-plugins>

  <external-component-plugins>
    <target-component>org.exoplatform.commons.api.notification.channel.ChannelManager</target-component>
    <component-plugin>
      <name>mail.channel.matrix.template</name>
      <set-method>registerTemplateProvider</set-method>
      <type>io.meeds.chat.notification.mail.MailTemplateProvider</type>
      <init-params>
        <value-param>
          <name>channel-id</name>
          <value>MAIL_CHANNEL</value>
        </value-param>
      </init-params>
    </component-plugin>
  </external-component-plugins>

  <external-component-plugins>
    <target-component>org.exoplatform.services.resources.ResourceBundleService</target-component>
    <component-plugin>
      <name>Matrix Resource Bundle</name>
      <set-method>addResourceBundle</set-method>
      <type>org.exoplatform.services.resources.impl.BaseResourceBundlePlugin</type>
      <init-params>
        <values-param>
          <name>classpath.resources</name>
          <value>locale.notification.MatrixChat</value>
        </values-param>
        <values-param>
          <name>portal.resource.names</name>
          <value>locale.notification.MatrixChat</value>
        </values-param>
      </init-params>
    </component-plugin>
  </external-component-plugins>
  <external-component-plugins>
    <target-component>org.exoplatform.social.core.search.SearchService</target-component>
    <component-plugin>
      <name>ChatSearchConnector</name>
      <set-method>addConnector</set-method>
      <type>org.exoplatform.social.core.search.SearchConnectorPlugin</type>
      <description>Chat messages search connector for the unified search</description>
      <init-params>
        <object-param>
          <name>ChatSearchConnector</name>
          <description>Search connector for chat messages (Matrix /search, run as the user)</description>
          <object type="org.exoplatform.social.core.search.SearchConnector">
            <field name="name">
              <string>chat</string>
            </field>
            <field name="contentType">
              <string>chat</string>
            </field>
            <field name="uri">
              <!-- The endpoint returns one hit per matching MESSAGE, which the connector's
                   formatSearchResult() then groups into one card per conversation with its match
                   count. Passing the app's display limit ({limit}, ~10) would cut the message
                   window: a busy conversation fills it alone, the other conversations disappear
                   and the counts are wrong. Ask for the server maximum instead and let the
                   grouping decide how many cards come out. -->
              <string><![CDATA[/matrix/rest/matrix/search?query={keyword}&limit=100]]></string>
            </field>
            <field name="enabled">
              <boolean>true</boolean>
            </field>
            <field name="jsModule">
              <string>SHARED/ChatSearch</string>
            </field>
            <field name="i18nBundle">
              <string>locale.portlet.matrix</string>
            </field>
            <field name="uiComponent">
              <string>chat-search-card</string>
            </field>
            <field name="icon">
              <string>fas fa-comments</string>
            </field>
            <field name="groupingEnabled">
              <boolean>true</boolean>
            </field>
            <field name="spaceFilterEnabled">
              <boolean>false</boolean>
            </field>
          </object>
        </object-param>
      </init-params>
    </component-plugin>
  </external-component-plugins>
</configuration>
