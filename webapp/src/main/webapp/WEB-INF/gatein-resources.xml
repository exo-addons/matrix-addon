<gatein-resources xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://www.exoplatform.org/xml/ns/gatein_resources_1_5 http://www.exoplatform.org/xml/ns/gatein_resources_1_5"
                  xmlns="http://www.exoplatform.org/xml/ns/gatein_resources_1_5">
  <portal-skin>
    <skin-name>Enterprise</skin-name>
    <skin-module>matrix</skin-module>
    <css-path>/css/matrix.css</css-path>
    <css-priority>120</css-priority>
    <filtered>true</filtered>
  </portal-skin>

  <portlet-skin>
    <application-name>matrix</application-name>
    <portlet-name>Matrix</portlet-name>
    <skin-name>Enterprise</skin-name>
    <additional-module>matrix</additional-module>
    <additional-module>PeopleList</additional-module>
  </portlet-skin>

  <portlet>
    <name>Matrix</name>
    <module>
      <!-- The load-group other add-ons join to contribute to the chat's
           ('chat', 'message-action') and ('chat', 'composer-action') extension
           points: a contributor's module sits in matrixGRP so it is present
           wherever the chat renders, and is then required by name — its module
           name MUST contain "ChatActionExtension" (see
           vue-apps/matrix/js/ChatActionExtensions.js). -->
      <load-group>matrixGRP</load-group>
      <script>
        <minify>false</minify>
        <path>/js/matrix.bundle.js</path>
      </script>
      <depends>
        <module>vue</module>
      </depends>
      <depends>
        <module>vuetify</module>
      </depends>
      <depends>
        <module>commonVueComponents</module>
      </depends>
      <depends>
        <module>suggester</module>
      </depends>
      <depends>
        <module>eXoVueI18n</module>
      </depends>
      <depends>
        <module>extensionRegistry</module>
      </depends>
      <depends>
        <module>vueDraggable</module>
      </depends>
      <depends>
        <module>emojiPicker</module>
      </depends>
      <depends>
        <module>spaceForm</module>
      </depends>
      <depends>
        <module>spaceMembersDrawer</module>
      </depends>
      <depends>
        <module>commons-cometd3</module>
        <as>cCometd</as>
      </depends>
      <depends>
        <module>jquery</module>
        <as>$</as>
      </depends>
    </module>
  </portlet>
  <portlet>
    <name>MatrixAdministration</name>
    <module>
      <script>
        <minify>false</minify>
        <path>/js/matrixAdministration.bundle.js</path>
      </script>
      <depends>
        <module>vue</module>
      </depends>
      <depends>
        <module>vuetify</module>
      </depends>
      <depends>
        <module>commonVueComponents</module>
      </depends>
      <depends>
        <module>eXoVueI18n</module>
      </depends>
      <depends>
        <module>extensionRegistry</module>
      </depends>
    </module>
  </portlet>

  <!-- Contributes "Send by chat" to the Documents file menu. The name MUST
       contain "DocumentsExtension": the Documents app discovers contributors via
       includeExtensions('DocumentsExtension'), so a module merely present in the
       load-group would never run. Sending a file to a conversation is the chat's
       own feature, which is why it ships here rather than in whichever add-on
       happens to sit beside it. -->
  <module>
    <name>MatrixDocumentsExtension</name>
    <load-group>DocumentsGRP</load-group>
    <script>
      <path>/js/matrixDocumentsExtension.bundle.js</path>
    </script>
    <depends>
      <module>vue</module>
    </depends>
    <depends>
      <module>vuetify</module>
    </depends>
    <depends>
      <module>extensionRegistry</module>
    </depends>
  </module>

  <module>
    <name>MatrixQuickActionExtensions</name>
    <load-group>QuickActionsGrp</load-group>
    <script>
      <path>/js/matrixQuickActionExtensions.bundle.js</path>
    </script>
    <depends>
      <module>vue</module>
    </depends>
    <depends>
      <module>vuetify</module>
    </depends>
    <depends>
      <module>eXoVueI18n</module>
    </depends>
    <depends>
      <module>extensionRegistry</module>
    </depends>
    <depends>
      <module>commonVueComponents</module>
    </depends>
  </module>

  <module>
    <name>MatrixFavoriteDrawerExtension</name>
    <load-group>FavoriteDrawerGRP</load-group>
    <script>
      <path>/js/matrixFavoritesExtension.bundle.js</path>
    </script>
    <depends>
      <module>vue</module>
    </depends>
    <depends>
      <module>vuetify</module>
    </depends>
    <depends>
      <module>eXoVueI18n</module>
    </depends>
    <depends>
      <module>extensionRegistry</module>
    </depends>
  </module>

  <module>
    <name>MatrixChatNotificationExtension</name>
    <load-group>notificationGRP</load-group>
    <script>
      <path>/js/matrixChatNotificationsExtension.bundle.js</path>
    </script>
    <depends>
      <module>vue</module>
    </depends>
    <depends>
      <module>vuetify</module>
    </depends>
    <depends>
      <module>eXoVueI18n</module>
    </depends>
    <depends>
      <module>extensionRegistry</module>
    </depends>
  </module>

  <module>
    <name>analyticsExtensionMatrix</name>
    <load-group>commonAnalyticsVueComponentsGroup</load-group>
    <script>
      <path>/js/analyticsExtensionMatrix.bundle.js</path>
    </script>
    <depends>
      <module>vue</module>
    </depends>
    <depends>
      <module>vuetify</module>
    </depends>
    <depends>
      <module>eXoVueI18n</module>
    </depends>
    <depends>
      <module>extensionRegistry</module>
    </depends>
    <depends>
      <module>commonVueComponents</module>
    </depends>
  </module>

  <module>
    <name>MatrixAiUxBindingExtension</name>
    <load-group>aiUxBindingExtenionsGRP</load-group>
    <script>
      <path>/js/aiUxBindingExtensionMatrix.bundle.js</path>
    </script>
    <depends>
      <module>vue</module>
    </depends>
    <depends>
      <module>extensionRegistry</module>
    </depends>
  </module>

  <module>
    <name>MatrixPWAUserSettings</name>
    <load-group>pwaUserSettingsGRP</load-group>
    <script>
      <path>/js/chatPwaSettings.bundle.js</path>
    </script>
    <depends>
      <module>commonVueComponents</module>
    </depends>
    <depends>
      <module>vue</module>
    </depends>
    <depends>
      <module>vuetify</module>
    </depends>
    <depends>
      <module>eXoVueI18n</module>
    </depends>
    <depends>
      <module>extensionRegistry</module>
    </depends>
  </module>

  <module>
    <name>MatrixSpaceTemplateManagementExtension</name>
    <load-group>SpaceTemplateManagement</load-group>
    <script>
      <path>/js/matrixSpaceTemplateExtension.bundle.js</path>
    </script>
    <depends>
      <module>vue</module>
    </depends>
    <depends>
      <module>vuetify</module>
    </depends>
    <depends>
      <module>eXoVueI18n</module>
    </depends>
    <depends>
      <module>extensionRegistry</module>
    </depends>
    <depends>
      <module>commonVueComponents</module>
    </depends>
  </module>

  <module>
    <name>matrixManageSpacesExtension</name>
    <load-group>SpacesAdministration</load-group>
    <script>
      <path>/js/matrixSpacesAdministrationExtension.bundle.js</path>
    </script>
    <depends>
      <module>vue</module>
    </depends>
    <depends>
      <module>vuetify</module>
    </depends>
    <depends>
      <module>eXoVueI18n</module>
    </depends>
    <depends>
      <module>extensionRegistry</module>
    </depends>
    <depends>
      <module>commonVueComponents</module>
    </depends>
  </module>

  <module>
    <name>ChatSearch</name>
    <script>
      <path>/js/chatSearch.bundle.js</path>
    </script>
    <depends>
      <module>vue</module>
    </depends>
    <depends>
      <module>vuetify</module>
    </depends>
    <depends>
      <module>eXoVueI18n</module>
    </depends>
    <depends>
      <module>commonVueComponents</module>
    </depends>
    <depends>
      <module>extensionRegistry</module>
    </depends>
    <depends>
      <module>jquery</module>
      <as>$</as>
    </depends>
  </module>

</gatein-resources>
